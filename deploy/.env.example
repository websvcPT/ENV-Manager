# Copy this file to .env next to docker-compose.yaml and adjust it. Lines starting with # are
# optional settings shown with their default. Every variable is described in the README table
# "Environment variables".
#
# Not listed here: ENVMANAGER_KEY_FILE (docker-compose.yaml sets it to the mounted key file;
# ENVMANAGER_KEY must not be set as well, both together are refused), ENVMANAGER_DATA_PATH (the
# image sets it to the /data volume), ENVMANAGER_TITLE and ENVMANAGER_DESCRIPTION (they name the
# API documentation pages, which production does not serve) and the development and testing only
# settings ENVMANAGER_SERVE_DOCS, ENVMANAGER_DEMO_ROOT and ENVMANAGER_LOGIN_IP_MAX_FAILURES.

# Required. The address people open. An https address makes the session cookie Secure; behind a
# reverse proxy that ends https use the https address.
ENVMANAGER_BASE_URL=https://env.example.com

# Required. Secret that signs the CSRF tokens, at least 32 characters. Generate one with
# openssl rand -hex 32 and keep it out of version control.
ENVMANAGER_CSRF_SECRET=

# Comma separated addresses or networks of the reverse proxies whose X-Forwarded-For and
# X-Forwarded-Proto headers are believed, for example 172.18.0.0/16. Empty: no proxy is trusted.
# ENVMANAGER_TRUSTED_PROXIES=

# Comma separated addresses or networks that may use the application at all, for example
# 203.0.113.0/24. Everything else gets a 403. Empty: everyone.
# ENVMANAGER_ALLOWED_SOURCES=

# Comma separated http or https origins that may call the API from a browser (no wildcard).
# Empty: same origin only.
# ENVMANAGER_CORS_ORIGINS=

# Turns error reporting to Sentry on. Empty: off.
# ENVMANAGER_SENTRY_DSN=

# Log level: CRITICAL, ERROR, WARNING, INFO or DEBUG.
# ENVMANAGER_LOG_LEVEL=INFO

# Name of the deployment environment, reported to Sentry and OpenTelemetry. Keep production.
# ENVMANAGER_ENVIRONMENT=production

# Path of the Docker socket inside the container, used by post-deploy commands. Change it only if
# the socket is mounted somewhere else.
# ENVMANAGER_DOCKER_SOCKET=/var/run/docker.sock

# Port the application listens on inside the container. If you change it, change the published
# port in docker-compose.yaml too.
# ENVMANAGER_PORT=8080
