FROM python:3.14-slim
ARG APP_UID=1000
ARG APP_GID=1000
ENV PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    UV_CACHE_DIR=/opt/uv-cache \
    PATH=/opt/venv/bin:$PATH \
    HOME=/home/app \
    RUFF_CACHE_DIR=/tmp/ruff-cache \
    MYPY_CACHE_DIR=/tmp/mypy-cache
COPY --from=ghcr.io/astral-sh/uv:0.13.1 /uv /uvx /usr/local/bin/
COPY --from=docker:29.9.1-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker:29.9.1-cli /usr/local/libexec/docker/cli-plugins/docker-compose \
    /usr/local/libexec/docker/cli-plugins/docker-compose
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && apt-get clean \
    && find /var/lib/apt/lists -type f -delete \
    && groupadd --gid "$APP_GID" app \
    && useradd --uid "$APP_UID" --gid "$APP_GID" --create-home --shell /bin/sh app \
    && mkdir -p /app /data /opt/venv /opt/uv-cache \
    && chown app:app /app /data /opt/venv /opt/uv-cache /home/app \
    && printf '#!/bin/sh\nexec python -m app.cli "$@"\n' > /usr/local/bin/envmanager \
    && chmod 755 /usr/local/bin/envmanager
USER app
WORKDIR /app
EXPOSE 8080
