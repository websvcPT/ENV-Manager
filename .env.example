# Copy to .env for local development. Names only; never commit real values.
ENVMANAGER_KEY=
ENVMANAGER_KEY_FILE=
ENVMANAGER_BASE_URL=http://localhost:8080
ENVMANAGER_PORT=8080
# Comma separated IPv4 and IPv6 addresses or networks whose X-Forwarded-For and
# X-Forwarded-Proto headers are believed, e.g. 172.18.0.2,172.19.0.0/16,fd00::/8.
# "*" and networks holding every address (0.0.0.0/0, ::/0) are refused. Empty: no proxy.
ENVMANAGER_TRUSTED_PROXIES=
# Comma separated IPv4 and IPv6 addresses or networks that may use the application at all,
# e.g. 203.0.113.0/24,2001:db8::/32. Everything else gets a 403. Empty: everyone.
ENVMANAGER_ALLOWED_SOURCES=
ENVMANAGER_DATA_PATH=/data
ENVMANAGER_LOG_LEVEL=INFO
ENVMANAGER_CSRF_SECRET=
ENVMANAGER_CORS_ORIGINS=
ENVMANAGER_SENTRY_DSN=
ENVMANAGER_ENVIRONMENT=development
# Failed sign ins per client address in 15 minutes before it is locked (default 20). Only accepted
# when ENVMANAGER_ENVIRONMENT is development or testing; the development stack sets it high so
# browser specs, which share one address, never lock themselves out.
# ENVMANAGER_LOGIN_IP_MAX_FAILURES=1000
